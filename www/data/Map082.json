on"]},{"code":401,"indent":0,"parameters":["join them in their perpetual agony..."]},{"code":101,"indent":0,"parameters":["",0,2,0]},{"code":401,"indent":0,"parameters":["\\C[13]I continued to stand back up and complete"]},{"code":401,"indent":0,"parameters":["my sentence, one swing after another."]},{"code":101,"indent":0,"parameters":["",0,2,0]},{"code":401,"indent":0,"parameters":["\\C[13]I was purely motivated by \\C[10]one thing\\C[13]"]},{"code":401,"indent":0,"parameters":["that I had to do. \\!\\C[10]One last act\\C[13], before I accepted"]},{"code":401,"indent":0,"parameters":["that there was nothing left for me once and for all."]},{"code":230,"indent":0,"parameters":[60]},{"code":224,"indent":0,"parameters":[[255,0,0,255],60,false]},{"code":101,"indent":0,"parameters":["",0,2,0]},{"code":401,"indent":0,"parameters":["\\C[13]I must kill the \\C[10]Chairman of the AEGIS Corporation.\\C"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,2,0]},{"code":401,"indent":0,"parameters":["\\C[13]I had to get my revenge on ALL of them, no matter"]},{"code":401,"indent":0,"parameters":["the cost!"]},{"code":101,"indent":0,"parameters":["",0,2,0]},{"code":401,"indent":0,"parameters":["\\C[13]I will never rest until they've realized how they've"]},{"code":401,"indent":0,"parameters":["crossed me."]},{"code":101,"indent":0,"parameters":["",0,2,0]},{"code":401,"indent":0,"parameters":["\\C[13]\\fi\\{All of AEGIS must \\C[10]PAY!\\C"]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,2,0]},{"code":401,"indent":0,"parameters":["\\C[13]It was that drive that I had used as fuel which allowed"]},{"code":401,"indent":0,"parameters":["me to continue moving forward through all these years,"]},{"code":401,"indent":0,"parameters":["all these monotonous days."]},{"code":223,"indent":0,"parameters":[[-255,-255,-255,0],60,true]},{"code":223,"indent":0,"parameters":[[0,0,0,0],60,true]},{"code":101,"indent":0,"paramet